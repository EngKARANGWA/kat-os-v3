# Copy to .env and fill in:  cp .env.example .env

# Your free DuckDNS address (gets HTTPS automatically). For a shop PC on the local network use:  KAT_DOMAIN=:80
KAT_DOMAIN=katos.duckdns.org

# Long random text. Generate one with:  openssl rand -hex 32
KAT_SECRET_KEY=

# 1 when using HTTPS (KAT_DOMAIN is a real domain). Set to 0 when KAT_DOMAIN=:80
KAT_COOKIE_SECURE=1

# Database. Option 1 (free Neon): paste your Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Option 2 (PostgreSQL on this server, started with --profile localdb):
# DATABASE_URL=postgresql://kat:CHANGE_ME@db:5432/kat_os
# POSTGRES_PASSWORD=CHANGE_ME

# First General Manager account (only used when the database has no users yet)
KAT_ADMIN_USERNAME=
KAT_ADMIN_PASSWORD=
KAT_ADMIN_NAME=

# Optional: email notifications through Resend (free tier: 3,000 emails/month)
RESEND_API_KEY=
KAT_EMAIL_FROM=Kigali Apple Tech <notifications@kigaliappletech.com>
KAT_EMAIL_REPLY_TO=
